# SPDX-License-Identifier: GPL-3.0-or-later
# FlowBridge; local contest configuration. See LICENSE.
# Edit this file before docker compose up. Root .env and shell variables take precedence.
# Database credentials stay in .env; provider keys stay in langflow/data/agent.env.

FLOWBRIDGE_DEV_ENV_FILE=.env
FLOWBRIDGE_DEV_API_PORT=18082
FLOWBRIDGE_DEV_IAM_PORT=19444
FLOWBRIDGE_CHAT_PORT=7861
FLOWBRIDGE_CHAT_SOURCE_DIR=./langflow/data
FLOWBRIDGE_CHAT_AGENT_ENV=./langflow/data/agent.env

# true: apply Alembic upgrades to the configured DB. false: require the existing schema head.
FLOWBRIDGE_COMPOSE_MIGRATE=true
# Reconcile the documented demo users/grants automatically; does not reset existing passwords/OTP.
FLOWBRIDGE_TEAM_ACCOUNTS_ENABLED=true
FLOWBRIDGE_TEAM_TEST_PASSWORD=FlowBridgeTest@2026
# Only needed when this DB has an unrelated existing application ADMIN.
FLOWBRIDGE_TEAM_GRANTED_BY=
FLOWBRIDGE_COMPOSE_UPGRADE_FLOWS=true

# Optional engines. Enable only after preparing the required model/artifact/cache and service grants.
FLOWBRIDGE_CHAT_ML=false
FLOWBRIDGE_CHAT_RAG=false
FLOWBRIDGE_CHAT_MODELS_DIR=./.cache/models
FLOWBRIDGE_CHAT_ML_DIR=./.cache/ml
FLOWBRIDGE_AGENT_HUB_ENABLED=true
FLOWBRIDGE_AGENT_HUB_WORKER_ENABLED=true
