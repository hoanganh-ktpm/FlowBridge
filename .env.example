# SPDX-License-Identifier: GPL-3.0-or-later
# FlowBridge configuration template; see LICENSE for GNU GPL v3-or-later terms.
# No credentials belong in this file. Settings loads .env from the working directory.
# A blank URL and password keep the development bootstrap disconnected from PostgreSQL.

FLOWBRIDGE_ENVIRONMENT=development
FLOWBRIDGE_HOST=127.0.0.1
FLOWBRIDGE_PORT=8000
FLOWBRIDGE_LOG_LEVEL=INFO
FLOWBRIDGE_DOCS_ENABLED=false
# Opt-in structured access log omits query strings and includes validated correlation.
FLOWBRIDGE_HTTP_ACCESS_LOG_ENABLED=false
# Real RAG over local fixtures; opt-in, loopback development/test only, empty DSN.
FLOWBRIDGE_RAG_DEV_ENABLED=false
FLOWBRIDGE_RAG_DEV_CATALOG_PATH=examples/rag/catalog.json
FLOWBRIDGE_RAG_DEV_INDEX_PATH=.cache/rag
FLOWBRIDGE_RAG_DEV_MODEL_CACHE_PATH=.cache/models
# ML endpoints use the application database and the existing IdP/role policy.
FLOWBRIDGE_ML_ENABLED=false
FLOWBRIDGE_ML_CONTEXT_PATH=.cache/ml/context.json
FLOWBRIDGE_ML_CHECKPOINT_PATH=.cache/models/tabicl-classifier-v2-20260212.ckpt
# Optional: set to the SHA-256 printed by the explicit download-checkpoint command.
# FLOWBRIDGE_ML_CHECKPOINT_SHA256=YOUR_VERIFIED_SHA256
FLOWBRIDGE_ML_DEVICE=cpu
FLOWBRIDGE_ML_N_ESTIMATORS=8
FLOWBRIDGE_ML_CPU_THREADS=4
FLOWBRIDGE_ML_MAX_CONTEXT_ROWS=5000
FLOWBRIDGE_ML_MAX_CANDIDATES=100
FLOWBRIDGE_ML_MAX_HISTORY_ROWS=20000
FLOWBRIDGE_ML_HISTORY_DAYS=180
FLOWBRIDGE_ML_QUEUE_TIMEOUT_SECONDS=5
FLOWBRIDGE_ML_REQUEST_TIMEOUT_SECONDS=120
FLOWBRIDGE_ML_PREDICTION_MAX_AGE_SECONDS=86400
FLOWBRIDGE_ML_RISK_THRESHOLD=0.70
# Only enable after operations confirms receipt reporting coverage. Missing reports are not zero.
FLOWBRIDGE_ML_RECEIPT_COVERAGE_CONFIRMED=false
FLOWBRIDGE_DATABASE_URL=
# Alternative to a URL: raw password (no percent-encoding), plus host and user.
# Explicit DATABASE_URL takes precedence over the component fields.
# Supabase session pooler: copy the exact host/user from Dashboard > Connect, port 5432.
# Quote passwords with single quotes in .env; escape quotes/backslashes per dotenv syntax.
# FLOWBRIDGE_DATABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# FLOWBRIDGE_DATABASE_USER=postgres.YOUR_PROJECT_REF
FLOWBRIDGE_DATABASE_PORT=5432
FLOWBRIDGE_DATABASE_NAME=postgres
FLOWBRIDGE_DATABASE_PASSWORD=
FLOWBRIDGE_DATABASE_SSL=require
# queue: bounded application pool; null: Supabase handles pooling, no idle app connections.
FLOWBRIDGE_DATABASE_POOL_MODE=queue
FLOWBRIDGE_DATABASE_POOL_SIZE=5
FLOWBRIDGE_DATABASE_MAX_OVERFLOW=10
FLOWBRIDGE_DATABASE_POOL_TIMEOUT_SECONDS=10
FLOWBRIDGE_DATABASE_CONNECT_TIMEOUT_SECONDS=10
FLOWBRIDGE_DATABASE_COMMAND_TIMEOUT_SECONDS=30
FLOWBRIDGE_HTTP_TIMEOUT_SECONDS=10
FLOWBRIDGE_HTTP_MAX_CONNECTIONS=100
FLOWBRIDGE_HEALTH_TIMEOUT_SECONDS=2

# IdP token introspection (RFC 7662); missing configuration denies protected business API access.
# Use exact issuer/audience and an HTTPS introspection endpoint from the IdP.
FLOWBRIDGE_OIDC_ISSUER=
FLOWBRIDGE_OIDC_AUDIENCE=
FLOWBRIDGE_OIDC_INTROSPECTION_URL=
FLOWBRIDGE_OIDC_CLIENT_ID=
FLOWBRIDGE_OIDC_CLIENT_SECRET=
FLOWBRIDGE_OIDC_CA_BUNDLE=
# JSON arrays: allowed token-issuing clients; service clients also determine account_type.
FLOWBRIDGE_OIDC_ALLOWED_CLIENTS=["flowbridge-web-a","flowbridge-web-b","flowbridge-ai","flowbridge-po"]
FLOWBRIDGE_OIDC_SERVICE_CLIENTS=["flowbridge-ai","flowbridge-po"]
# Optional read-only Keycloak directory for linking/provisioning an existing IdP user.
FLOWBRIDGE_OIDC_ADMIN_URL=
FLOWBRIDGE_OIDC_ADMIN_CLIENT_ID=
FLOWBRIDGE_OIDC_ADMIN_CLIENT_SECRET=
# Explicit browser origins; leave empty when CORS is handled by the gateway.
FLOWBRIDGE_CORS_ORIGINS=[]
# Only exact gateway IPs/CIDRs controlled by this deployment; [] trusts no proxy.
FLOWBRIDGE_TRUSTED_PROXY_IPS=[]
# Optional explicit single-tenant/application core binding, JSON; omit until configured.
# See docs/IDENTITY-CORE.md. No tenant or permission is inferred from caller headers.
# FLOWBRIDGE_CORE_IDENTITY='{"tenant_id":"YOUR_TENANT","application_id":"YOUR_APP","web_client_id":"flowbridge-web-a","mobile_client_id":"flowbridge-web-b","role_permissions":{"EMPLOYEE":["identity:read"]},"service_clients":{}}'
# Local container runner reads only DATABASE_* from the selected --env-file; see docs/DEV-CONTAINERS.md.
# Default docker compose up: edit compose.env for ports/features; image manifests stay in infra/*/images.env.
# Legacy development helpers still accept CLI options; see docs/DEV-CONTAINERS.md.
# Reserved for later workflow/storage adapters.
FLOWBRIDGE_WORKFLOW_BASE_URL=
FLOWBRIDGE_S3_ENDPOINT_URL=
FLOWBRIDGE_S3_QUARANTINE_BUCKET=flowbridge-quarantine
FLOWBRIDGE_S3_CLEAN_BUCKET=flowbridge-clean

# PostgreSQL RAG uses verified AI_SERVICE + X-Job-Context (analysis task UUID).
# Keep local fixture RAG disabled when connecting a database.
FLOWBRIDGE_RAG_POSTGRES_ENABLED=false
# Admin Markdown CRUD + durable indexing worker; apply migration 0004 first.
FLOWBRIDGE_RAG_MANAGER_ENABLED=false
# Read-only, authenticated database counts for Langflow frontend charts; independent of ML.
FLOWBRIDGE_DELIVERY_STATISTICS_ENABLED=false
FLOWBRIDGE_RAG_MANAGER_MAX_BYTES=2097152
FLOWBRIDGE_RAG_POSTGRES_MODEL_CACHE_PATH=.cache/models

# Opt-in authenticated chat; requires migration 0005 and langflow/start-sso.cmd.
FLOWBRIDGE_CHAT_ENABLED=false
FLOWBRIDGE_LANGFLOW_URL=http://127.0.0.1:7860
FLOWBRIDGE_LANGFLOW_FLOW_ID=flowbridge-ver2-central
FLOWBRIDGE_LANGFLOW_API_KEY=
FLOWBRIDGE_LANGFLOW_BRIDGE_SECRET=
FLOWBRIDGE_LANGFLOW_TIMEOUT_SECONDS=180
# Optional RAG service credentials; user token and job are selected per request, never here.
FLOWBRIDGE_LANGFLOW_AI_CLIENT_ID=
FLOWBRIDGE_LANGFLOW_AI_CLIENT_SECRET=

# Agent Hub web/mobile APIs, durable queue and SSE; migration 0006 + updated SSO bridge.
# Use an independent random 32+ character key; keep stable across API/worker restarts.
FLOWBRIDGE_AGENT_HUB_ENABLED=false
FLOWBRIDGE_AGENT_HUB_WORKER_ENABLED=true
FLOWBRIDGE_AGENT_HUB_QUEUE_TIMEOUT_SECONDS=300
FLOWBRIDGE_AGENT_HUB_CREDENTIAL_KEY=
