# IdentitySettings reads these values when integrated into an application.
FLOWBRIDGE_OIDC_ISSUER=
FLOWBRIDGE_OIDC_AUDIENCE=
FLOWBRIDGE_OIDC_INTROSPECTION_URL=
FLOWBRIDGE_OIDC_CLIENT_ID=
FLOWBRIDGE_OIDC_CLIENT_SECRET=
FLOWBRIDGE_OIDC_CA_BUNDLE=
FLOWBRIDGE_OIDC_ALLOWED_CLIENTS=[]
FLOWBRIDGE_OIDC_SERVICE_CLIENTS=[]
FLOWBRIDGE_OIDC_ADMIN_URL=
FLOWBRIDGE_OIDC_ADMIN_CLIENT_ID=
FLOWBRIDGE_OIDC_ADMIN_CLIENT_SECRET=
FLOWBRIDGE_CORS_ORIGINS=[]
FLOWBRIDGE_TRUSTED_PROXY_IPS=[]

# Hasura control plane; no Core DB or Hasura instance is required for unit tests.
FLOWBRIDGE_HASURA_ENDPOINT=http://127.0.0.1:8080
FLOWBRIDGE_HASURA_ADMIN_SECRET=
FLOWBRIDGE_HASURA_TIMEOUT_SECONDS=10
FLOWBRIDGE_HASURA_ALLOWED_SOURCES=[]
FLOWBRIDGE_HASURA_ALLOWED_DATABASE_HOSTS=[]
FLOWBRIDGE_HASURA_SECRET_BINDINGS={}
FLOWBRIDGE_HASURA_SELECT_LIMIT=1000
# Supply approved source DSNs through local environment/secret storage, never Git.
# WAREHOUSE_READ_DATABASE_URL=postgresql://reader:<encoded-password>@host:5432/warehouse_db?sslmode=verify-full

# Database administration only; never use migration credentials for Hasura reads.
# Preserve an existing .env; fill these values locally without committing credentials.
DXOS_LAYOUT=databases
DXOS_ADMIN_URL=
DXOS_SALES_URL=
DXOS_WAREHOUSE_URL=
DXOS_LOGISTICS_URL=
DXOS_CORE_URL=
# Optional schema layout and sanitized connection examples: docs/database/README.md.

# Native Core composition. Existing-Supabase acceptance requires explicit runner opt-in.
# This explicit setting takes precedence over DXOS_CORE_URL.
FLOWBRIDGE_CORE_DATABASE_URL=
FLOWBRIDGE_CORE_SOURCE_SCOPES={}
FLOWBRIDGE_CORE_WORKER_POLL_SECONDS=2
# Enable only after verifying Hasura JWT configuration and private GraphQL ingress.
FLOWBRIDGE_CORE_VERIFIED_HASURA_AUTH_PROFILE=false
FLOWBRIDGE_CORE_HASURA_JWT_SIGNING_KEY=
FLOWBRIDGE_CORE_HASURA_JWT_ISSUER=flowbridge-core
FLOWBRIDGE_CORE_HASURA_JWT_AUDIENCE=flowbridge-data
# Isolated persistence tests never fall back to DXOS_ADMIN_URL or application DBs.
# DXOS_TEST_ADMIN_URL=postgresql+psycopg://test_user:<encoded-password>@127.0.0.1:55439/postgres?sslmode=require
# Existing-Supabase E2E: docs/DOCKER.md. Isolated harness: docs/AUTOMATED-ONBOARDING.md.
# FLOWBRIDGE_E2E_ENABLED=0
