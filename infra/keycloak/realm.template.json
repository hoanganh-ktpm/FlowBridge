{
  "realm": "flowbridge",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 180,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 3600,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "authenticationFlows": [
    {
      "id": "b987b5aa-1345-43d9-b66c-83d932aa5729",
      "alias": "flowbridge-browser-mfa-v2",
      "description": "FlowBridge SSO accepts only LoA 2; password and native TOTP on fresh authentication",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "flowAlias": "flowbridge-forms-mfa-v2",
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20
        }
      ]
    },
    {
      "alias": "flowbridge-forms-mfa-v2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "flowbridge-password-totp-v2",
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 10
        }
      ]
    },
    {
      "alias": "flowbridge-password-totp-v2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "flowbridge-loa2-v2",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 30
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "flowbridge-loa2-v2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "900"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "flowbridge-api-audience",
      "protocol": "openid-connect",
      "attributes": {},
      "protocolMappers": [
        {
          "name": "flowbridge-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "flowbridge-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "flowbridge-web-a",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authenticationFlowBindingOverrides": {
        "browser": "b987b5aa-1345-43d9-b66c-83d932aa5729"
      },
      "protocolMappers": [
        {
          "name": "flowbridge-acr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-acr-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "redirectUris": [
        "${SSO_ORIGIN_A}/",
        "http://127.0.0.1:5174/"
      ],
      "webOrigins": [
        "${SSO_ORIGIN_A}",
        "http://127.0.0.1:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SSO_ORIGIN_A}/##http://127.0.0.1:5174/",
        "minimum.acr.value": "2",
        "default.acr.values": "2",
        "acr.loa.map": "{\"2\":2}"
      },
      "defaultClientScopes": [
        "flowbridge-api-audience"
      ]
    },
    {
      "clientId": "flowbridge-api",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${SSO_API_SECRET}",
      "defaultClientScopes": [
        "flowbridge-api-audience"
      ]
    },
    {
      "clientId": "flowbridge-directory",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${SSO_DIRECTORY_SECRET}",
      "defaultClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-flowbridge-directory",
      "enabled": true,
      "serviceAccountClientId": "flowbridge-directory",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "view-clients"
        ]
      }
    }
  ]
}
