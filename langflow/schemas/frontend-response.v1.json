        "field": {
          "title": "Field",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "decimal",
            "boolean",
            "date"
