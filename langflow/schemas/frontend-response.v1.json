{
  "$defs": {
    "Chart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "bar",
            "line",
            "pie"
          ],
          "title": "Type",
          "type": "string"
        },
        "orientation": {
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "stacking": {
          "default": "none",
          "enum": [
            "none",
            "normal",
            "percent"
          ],
          "title": "Stacking",
          "type": "string"
        },
        "x_field": {
          "title": "X Field",
          "type": "string"
        },
        "x_label": {
          "title": "X Label",
          "type": "string"
        },
        "y_label": {
          "title": "Y Label",
          "type": "string"
        },
        "y_unit": {
          "title": "Y Unit",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/Series"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Series",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "dataset_id",
        "type",
        "x_field",
        "x_label",
        "y_label",
        "y_unit",
        "series"
      ],
      "title": "Chart",
      "type": "object"
    },
    "Column": {
