    "tables": {
      "items": {
        "$ref": "#/$defs/Table"
      },
      "maxItems": 30,
      "title": "Tables",
      "type": "array"
    },
    "charts": {
      "items": {
        "$ref": "#/$defs/Chart"
      },
      "maxItems": 30,
      "title": "Charts",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "maxItems": 250,
      "title": "Sources",
      "type": "array"
