  "title": "FrontendResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later. Semantic cross-field checks also require validate_response()."
