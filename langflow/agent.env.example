# Actual credentials belong in ignored langflow/data/agent.env, never in flow JSON.
OPENAI_API_KEY=
FLOWBRIDGE_API_ORIGIN=http://127.0.0.1:8000
# A real employee/approver/warehouse access token for read APIs and ML scenarios.
FLOWBRIDGE_USER_ACCESS_TOKEN=
# Optional RAG: both must be configured by the application, not by the model.
FLOWBRIDGE_AI_ACCESS_TOKEN=
FLOWBRIDGE_JOB_CONTEXT=

# Serving profile (start-sso.cmd): same random secret as backend, at least 32 characters.
FLOWBRIDGE_LANGFLOW_BRIDGE_SECRET=
FLOWBRIDGE_LANGFLOW_FLOW_ID=flowbridge-ver2-central
# Use a real native Langflow API key on backend. See docs/LANGFLOW-SSO.md.
